<Window x:Class="MulticastDelegate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №3"
        Height="560" Width="820" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        WindowState="Maximized">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
        <SolidColorBrush x:Key="BorderCol" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextCol" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="AccentCol" Color="#735d99"/>
        <SolidColorBrush x:Key="AccentHover" Color="#3f3157"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentCol}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B1C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Вхідні дані -->
        <GroupBox Grid.Row="0" Header="Вхідні дані" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Число:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="txtNumber" Width="140" Text="12345.6789"
                         VerticalAlignment="Center" Padding="2" />
                <TextBlock Text="Затримка, мс:" VerticalAlignment="Center" Margin="24,0,8,0" />
                <TextBox x:Name="txtDelay" Width="60" Text="1000"
                         VerticalAlignment="Center" Padding="2" />
            </StackPanel>
        </GroupBox>

        <!-- Склад мультикаст-делегата -->
        <GroupBox Grid.Row="1" Header="Методи у списку викликів делегата format" Padding="8"
                  Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="chkCurrency" Content="FormatNumberAsCurrency"
                          IsChecked="True" Margin="0,0,20,0" />
                <CheckBox x:Name="chkCommas" Content="FormatNumberWithCommas"
                          IsChecked="True" Margin="0,0,20,0" />
                <CheckBox x:Name="chkPlaces" Content="FormatNumberWithTwoPlaces"
                          IsChecked="True" />
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <Button x:Name="btnSequential" Content="Послідовний виклик (1 потік)" Width="210" Height="30"
                    Margin="0,0,8,0" Click="btnSequential_Click" />
            <Button x:Name="btnParallel" Content="Паралельний виклик (потоки)" Width="200"
                    Height="30" Margin="0,0,8,0" Click="btnParallel_Click" />
            <Button x:Name="btnClear" Content="Очистити журнал" Width="140" Height="30"
                    Click="btnClear_Click" />
        </StackPanel>

        <!-- Журнал -->
        <GroupBox Grid.Row="3" Header="Журнал роботи потоків" Padding="4">
            <RichTextBox x:Name="rtbLog" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Document>
                    <FlowDocument PageWidth="3000" />
                </RichTextBox.Document>
            </RichTextBox>
        </GroupBox>

        <!-- Рядок стану -->
        <TextBlock x:Name="lblStatus" Grid.Row="4" Margin="2,8,0,0" Text="Готово до роботи." />
    </Grid>
</Window>
